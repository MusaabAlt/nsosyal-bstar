# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git; never commit real passwords.
#
# Any config.yaml value can be set here: queue.size -> NSOSYAL_QUEUE_SIZE.
# A variable set in the real environment wins over this file.
# If the password contains @ : / or #, URL-encode it (@ -> %40).

NSOSYAL_DATABASE_URL=postgres://nsosyal:nsosyal_dev@127.0.0.1:5432/nsosyal?sslmode=disable
