{
  "name": "nsosyal-moderation-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc -b && vite build",
    "build:backend": "vue-tsc -b && vite build --outDir ../backend/web/dist --emptyOutDir && node scripts/keep-dist.mjs && node scripts/check-offline.mjs ../backend/web/dist",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
