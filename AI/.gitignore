# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Model and data artifacts: binaries are tracked by hash in artifacts/MANIFEST.md,
# not committed.
artifacts/**
!artifacts/MANIFEST.md
*.onnx
*.bin
*.safetensors
*.pt

# Raw datasets never enter the repo (licensing + personal data)
data/

# No eval result is committed before its protocol exists (eval/README.md).
eval/results/*.json
eval/results/*.tmp
!eval/results/.gitkeep

# Gate 1.5: named reference runs (python -m eval.run_all --results-dir eval/results/<name>) are
# ignored like the top-level results; the tracked eval/results/m4_stage1b.json is unaffected.
eval/results/*/

# A-head human annotation: templates and filled files hold corpus text (never committed); the
# committed ids file in eval/annotation/ carries the design and the ids only.
eval/annotation/private/

# Row-level reports that carry corpus text or the corpus gold label (e.g. the rule-v4 flip report's full
# version): private, never committed. The committed versions next to them hold ids and spans only.
eval/derived/private/
