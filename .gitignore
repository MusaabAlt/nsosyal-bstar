# --- environments / IDE ---
.venv/
venv/
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# --- raw data: never committed (licensing + size), keep the directory shape ---
data/**
!data/**/
!data/**/.gitkeep
# Exception: the train/dev split file. It holds row ids only -- no corpus text,
# so no licensing issue -- and phase 01 S1 requires the dev set to be identical
# across every row of the comparison matrix. Committing it makes that auditable
# instead of merely reproducible.
!data/splits/*.json

# --- results: summary JSON/CSV are committed evidence, everything else is not ---
results/**
!results/**/
!results/*.json
!results/*.csv
# Phase run directories (results/01_baseline_berturk/, ...) are one level down,
# which the top-level exceptions above do not reach. Their evidence files are
# committed: the repo copy of a result is canonical, the Drive mirror is not.
!results/**/*.json
!results/**/*.txt
!results/**/*.md
# ...with one exception, listed last so it wins: the per-row predictions carry
# corpus text (licensing, briefing S5) and are large. Phase 2 reads them from
# the Drive mirror or a local download, never from git.
results/**/dev_predictions.csv

# --- model artifacts / checkpoints ---
*.zip
*.bin
*.safetensors
checkpoints/
runs/
