# --- environments / IDE ---
.venv/
venv/
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.env

# --- raw data: never committed (licensing + size), keep the directory shape ---
data/**
!data/**/
!data/**/.gitkeep
# Exception: the train/dev split file. It holds row ids only -- no corpus text,
# so no licensing issue -- and phase 01 S1 requires the dev set to be identical
# across every row of the comparison matrix. Committing it makes that auditable
# instead of merely reproducible.
!data/splits/*.json
# Exception: the Phase 15 address flag. It holds seven Turkish pronouns and two
# pre-registered sensitivity sets -- a definition, not corpus data, so no
# licensing issue -- and Stage 4 requires the exact set to be committed BEFORE
# the flag is used. Committing it is the whole point; force-adding it under the
# ignore rule would leave later edits invisible to `git status`.
!data/deixis/*.json

# --- results: summary JSON/CSV are committed evidence, everything else is not ---
results/**
!results/**/
!results/*.json
!results/*.csv
# Phase run directories (results/01_baseline_berturk/, ...) are one level down,
# which the top-level exceptions above do not reach. Their evidence files are
# committed: the repo copy of a result is canonical, the Drive mirror is not.
!results/**/*.json
!results/**/*.txt
!results/**/*.md
# ...with one exception, listed last so it wins: any per-row prediction dump
# carries corpus text (licensing, briefing S5) and is large. Analyses read them
# from the Drive mirror or a local download, never from git.
results/**/*predictions*.csv

# --- model artifacts / checkpoints ---
*.zip
*.bin
*.safetensors
# *.pt was missing until 2026-08-23: `checkpoints/` only covers that one
# directory name, so a checkpoint downloaded to any other path (e.g. other/,
# a scratch folder) was committable. 442.5 MB per file, two of them.
*.pt
checkpoints/
runs/

# Offline demo asset bundle: 885.9 MB, rebuilt by demo/build_assets.py.
# Checkpoints are reproducible from a seed + a results file; they do not belong in git.
demo_assets/

# --- report build output: a measurement instrument, rebuilt on demand ---
# report/build_docx.py regenerates report_draft.docx from the committed
# template plus report/*.md. The .docx is a derived artifact (~2.5 MB, and it
# carries the template's embedded fonts and media), so the inputs are tracked
# and the output is not.
report/build/
